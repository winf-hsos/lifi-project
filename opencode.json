{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/course-assistant.md"],
  "model": "opencode/space-bunny-free",
  "small_model": "opencode/space-bunny-free",
  "enabled_providers": ["openai", "opencode"],
  "provider": {
    "openai": {
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna (course model)",
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "share": "disabled",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "python .opencode/scripts/*": "allow",
      "python3 .opencode/scripts/*": "allow",
      "py .opencode/scripts/*": "allow",
      "python .opencode\\scripts\\*": "allow",
      "py .opencode\\scripts\\*": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "py --version": "allow",
      "git --version": "allow",
      "code --version": "allow"
    }
  }
}
