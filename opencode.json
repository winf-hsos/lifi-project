{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/course-assistant.md"],
  "model": "openai/gpt-6-luna",
  "small_model": "openai/gpt-6-luna",
  "enabled_providers": ["openai", "opencode"],
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{file:openai.key}"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna (course model)"
        }
      }
    }
  },
  "share": "disabled",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "python .opencode/scripts/*": "allow",
      "python3 .opencode/scripts/*": "allow",
      "py .opencode/scripts/*": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "py --version": "allow",
      "git --version": "allow",
      "code --version": "allow"
    },
    "read": {
      "*": "allow",
      "*openai.key": "deny"
    }
  }
}
