{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-luna",
  "small_model": "openai/gpt-6-luna",
  "enabled_providers": ["openai", "opencode"],
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{file:openai.key}"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna (course model)"
        }
      }
    }
  },
  "share": "disabled",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "python tools/update_course.py*": "allow",
      "python3 tools/update_course.py*": "allow",
      "python tools/check_setup.py*": "allow",
      "python3 tools/check_setup.py*": "allow"
    },
    "read": {
      "*": "allow",
      "*openai.key": "deny"
    }
  }
}
